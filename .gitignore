# ---- PHI and patient-level artifacts: NEVER commit ----
# output/intermediate_phi/ is the ONLY place patient-level artifacts are written.
# Rule is by directory, not by extension: an extension rule misses the file type
# nobody thought of.
output/intermediate_phi/
logs/
*.parquet
*.csv
!config/*.csv
!output/**/final_no_phi/**/*.csv

# ---- R ----
.Rproj.user/
.Rhistory
.RData
.Ruserdata
renv/library/
renv/staging/
renv/local/
renv/cellar/

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# ---- OS ----
.DS_Store

# ---- site config (contains local paths) ----
config/config.json

# ---- local session state (progress log, todo, lessons) ----
.claude/
