# ---- Outputs: NEVER commit ----
# This repo ships to sites, and every site generates its own outputs. Nothing
# under output/ is tracked: PHI artifacts never leave the site, and the PHI-free
# set reaches the coordinating centre by upload, not by git. A bare `output/` is
# deliberate -- git does not descend into an excluded directory, which is exactly
# what we want here.
output/
logs/
*.parquet
!config/*.csv

# ---- R ----
.Rproj.user/
.Rhistory
.RData
.Ruserdata
renv/library/
renv/staging/
renv/local/
renv/cellar/

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# ---- OS ----
.DS_Store

# ---- one-off validation probes: local, never committed ----
# Scratch experiments that answer a question once and are not part of the
# pipeline. Anything a run depends on belongs in code/, and anything that must
# keep being true belongs in tests/ -- which IS tracked, because both runners'
# preflight invokes it.
validation/

# ---- reference material: local reading copies, never committed ----
# Publisher PDFs and working notes. A bare `references/` like `output/` above:
# git does not descend into an excluded directory. Nothing in the repo may depend
# on a file here -- see docs/references.md for the citations themselves.
references/

# ---- site config (contains local paths) ----
config/config.json

# ---- local session state (progress log, todo, lessons) ----
.claude/
