# ---- PHI and patient-level artifacts: NEVER commit ----
# Everything under output/ is treated as PHI unless explicitly allowed back.
# NOTE the trailing /* rather than a bare `output/`: git does not descend into an
# excluded DIRECTORY, so a bare `output/` makes every negation below dead and
# takes final_no_phi with it.
output/*
!output/final_no_phi/
output/final_no_phi/*
!output/final_no_phi/**/
!output/final_no_phi/**/*.csv
!output/final_no_phi/**/*.json
!output/final_no_phi/*.csv
!output/final_no_phi/*.json
logs/
*.parquet
!config/*.csv

# ---- R ----
.Rproj.user/
.Rhistory
.RData
.Ruserdata
renv/library/
renv/staging/
renv/local/
renv/cellar/

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# ---- OS ----
.DS_Store

# ---- site config (contains local paths) ----
config/config.json

# ---- local session state (progress log, todo, lessons) ----
.claude/
